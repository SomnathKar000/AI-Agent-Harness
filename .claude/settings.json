{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./packages/**)",
      "Edit(./scripts/**)",
      "Edit(./docs/**)",
      "Edit(./fixtures/*-template/**)",
      "Edit(./evals/**)",
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm -r build)",
      "Bash(pnpm -r test*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git worktree list*)",
      "Bash(git branch --list*)",
      "Bash(git -C * worktree list*)",
      "Bash(git -C * branch --list*)",
      "Bash(docker ps*)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(mkdir -p reports*)"
    ],
    "ask": [
      "Edit(./policy/**)",
      "Edit(./sandbox-image/**)",
      "Edit(./docker-compose.yml)",
      "Edit(./package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Edit(./.claude/**)",
      "Edit(./packages/policy/test/**)",
      "Edit(./packages/sandbox/test/**)",
      "Edit(./packages/agent/test/**)",
      "Edit(./packages/db/test/**)",
      "Edit(./packages/core/test/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(docker compose*)",
      "Bash(docker run*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git config*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  }
}
