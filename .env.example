# Database
DATABASE_ADMIN_URL=postgres://harness:harness_password@127.0.0.1:5433/harness
DATABASE_URL=postgres://harness_app:harness_app_password@127.0.0.1:5433/harness
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_password
POSTGRES_DB=harness

# Redis
REDIS_URL=redis://127.0.0.1:6379

# API
PORT=3000
HOST=127.0.0.1

# Anthropic (Host only - never expose to container or log)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub (Host only - never expose to container or log)
GITHUB_TOKEN=your-github-token-here

# Sandbox
SANDBOX_IMAGE=harness-sandbox:latest
